{
  "name": "api-pressure-lab",
  "version": "1.0.0",
  "description": "Windows 本地 API 压测工具，支持 OpenAI 兼容、Claude Messages 和 Gemini generateContent。",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ccw-HE/api-pressure-lab.git"
  },
  "bugs": {
    "url": "https://github.com/ccw-HE/api-pressure-lab/issues"
  },
  "homepage": "https://github.com/ccw-HE/api-pressure-lab#readme",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": ">=10"
  },
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "dev": "vite --host 127.0.0.1",
    "server": "node server/index.js",
    "app": "concurrently \"npm run server\" \"npm run dev\"",
    "build": "vite build --configLoader runner",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run --configLoader runner"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "express": "^5.2.1",
    "lucide-react": "^0.561.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "recharts": "^3.5.1",
    "typescript": "^5.9.3",
    "undici": "^7.29.0",
    "vite": "^7.3.6"
  },
  "devDependencies": {
    "concurrently": "^9.2.4",
    "vitest": "^4.0.16"
  }
}
